# Supabase — copy to .env and fill in your project credentials
# Quick setup: see scripts/setup-supabase.mjs or run `npm run supabase:seed`
#
# 1. Create a project at https://supabase.com/dashboard
# 2. npx supabase login && npx supabase link --project-ref <ref>
# 3. npm run supabase:push        (apply migrations)
# 4. npm run supabase:seed        (write .env + create dev accounts)
# 5. Restart dev server → http://localhost:5173/admin/login
#
# Dev accounts after seed:
#   Admin:   admin@hyderabadschool.test / Admin123!
#   Faculty: faculty@hyderabadschool.test / Faculty123!

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose to the browser (used for admin faculty provisioning)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
